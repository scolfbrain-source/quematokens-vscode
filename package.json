{
  "name": "quematokens",
  "displayName": "QuemaTokens",
  "description": "Tragaperras clásica de palanca. ¡Juega y quema tokens! Los tokens de tu IA alimentan el bote progresivo.",
  "version": "1.3.1",
  "publisher": "quematokens",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "other",
    "fun"
  ],
  "activationEvents": [
    "onCommand:quematokens.open",
    "onView:quematokens-main"
  ],
  "main": "./out/extension.js",
  "icon": "icons/icon128.png",
  "contributes": {
    "commands": [
      {
        "command": "quematokens.open",
        "title": "QuemaTokens: Abrir máquina",
        "category": "QuemaTokens",
        "icon": "$(rocket)"
      },
      {
        "command": "quematokens.spin",
        "title": "QuemaTokens: Tirar",
        "category": "QuemaTokens"
      },
      {
        "command": "quematokens.reset",
        "title": "QuemaTokens: Reiniciar",
        "category": "QuemaTokens"
      },
      {
        "command": "quematokens.stats",
        "title": "QuemaTokens: Stats",
        "category": "QuemaTokens"
      },
      {
        "command": "quematokens.exportUsage",
        "title": "QuemaTokens: Exportar uso",
        "category": "QuemaTokens"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quematokens-container",
          "title": "QuemaTokens",
          "icon": "icons/icon16.svg"
        }
      ]
    },
    "views": {
      "quematokens-container": [
        {
          "id": "quematokens-main",
          "name": "QuemaTokens",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "QuemaTokens",
      "properties": {
        "quematokens.autoSpin": {
          "type": "boolean",
          "default": false,
          "description": "Auto-spin cuando se detectan tokens de IA"
        },
        "quematokens.trackCopilot": {
          "type": "boolean",
          "default": true,
          "description": "Trackear tokens de Copilot via session files"
        },
        "quematokens.copilotSessionPath": {
          "type": "string",
          "default": "",
          "description": "Ruta custom a ~/.copilot/session-state/ (vacío = auto)"
        },
        "quematokens.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "API key OpenAI (opcional)"
        },
        "quematokens.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "API key Anthropic (opcional)"
        },
        "quematokens.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "API key Gemini (opcional)"
        }
      }
    },
    "chatParticipants": [
      {
        "id": "quematokens",
        "name": "quematokens",
        "fullName": "QuemaTokens 🎰",
        "description": "Stats de tokens y tragaperras",
        "commands": [
          { "name": "stats", "description": "Ver estadísticas de tokens" },
          { "name": "reset", "description": "Resetear stats" },
          { "name": "export", "description": "Exportar datos JSON" }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npx @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "@vscode/vsce": "^3.2.0"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.12"
  }
}
